# lexi.service - keeps Lexi Online running on the EC2 server, and restarts it
# after a crash or a reboot. See README.md, "Keep it running".
[Unit]
Description=Lexi Online word-card game
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/lexi-online
ExecStart=/usr/bin/node server.js
Environment=PORT=80
# Lets a normal user open port 80 (the default web port) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
